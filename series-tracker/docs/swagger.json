{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/series": {
            "get": {
                "description": "Get a list of all series in the database",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Retrieve all series",
                "responses": {
                    "200": {
                        "description": "Success, array of all fetched series",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Serie"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error, unspecified internal errors",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Inserts a new series into the database, make sure the series object includes all the necessary fields.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Create a new series",
                "parameters": [
                    {
                        "description": "Series info",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.Serie"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created, newly created series",
                        "schema": {
                            "$ref": "#/definitions/models.Serie"
                        }
                    },
                    "400": {
                        "description": "Invalid input, eg. invalid input fields",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Series conflict, eg. negative ranking or duplicate title",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error, unspecified internal errors",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/series/{id}": {
            "get": {
                "description": "Get details of a series using the provided ID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Retrieve a series by ID",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Series ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success, fetched series",
                        "schema": {
                            "$ref": "#/definitions/models.Serie"
                        }
                    },
                    "400": {
                        "description": "Invalid input, eg. non-integer ID",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Series not found, eg. an ID that doesn't exist in the database",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error, unspecified internal errors",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "Updates details of an existing series",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Update an existing series",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Series ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success, updated series",
                        "schema": {
                            "$ref": "#/definitions/models.Serie"
                        }
                    },
                    "400": {
                        "description": "Invalid input, eg. non-integer ID or invalid input fields",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Series not found, eg. ID that doesn't exist in the database",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Series conflict, eg. invalid values for episode or negative ranking",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error, unspecified internal errors",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Inserts a new series into the database, make sure the series object includes all the necessary fields.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Remove an existing series from the database",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Series ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "400": {
                        "description": "Invalid input, eg. non-integer ID",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Series not found, eg. ID that doesn't exist in the databas",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error, eg. database error",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/series/{id}/downvote": {
            "patch": {
                "description": "Decreases the rating (score) of the series with the specified ID by one vote.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Decrease series score",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Series ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success, updated series",
                        "schema": {
                            "$ref": "#/definitions/models.Serie"
                        }
                    },
                    "400": {
                        "description": "Invalid input, eg. non-integer ID",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Series not found, eg. ID that doesn't exist in the database",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Series conflict, eg. downvoting past 0",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error, unspecified internal errors",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/series/{id}/episode": {
            "patch": {
                "description": "Increments the current episode number of a series by one",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Advance series episode count",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Series ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success, updated series",
                        "schema": {
                            "$ref": "#/definitions/models.Serie"
                        }
                    },
                    "400": {
                        "description": "Invalid input, eg. non-integer ID",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Series not found, eg. ID that doesn't exist in the database",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "Series conflict, eg. trying to increment episode past last one",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error, unspecified internal errors",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/series/{id}/status": {
            "patch": {
                "description": "Updates the status of the series with the specified ID.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Update series status",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Series ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success, updated series",
                        "schema": {
                            "$ref": "#/definitions/models.Serie"
                        }
                    },
                    "400": {
                        "description": "Invalid input, eg. non-integer ID or invalid status",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Series not found, eg. ID that doesn't exist in the database",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error, unspecified internal errors",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/series/{id}/upvote": {
            "patch": {
                "description": "Increases the rating (score) of the series with the specified ID by one vote.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "series"
                ],
                "summary": "Increase series score",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Series ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success, updated series",
                        "schema": {
                            "$ref": "#/definitions/models.Serie"
                        }
                    },
                    "400": {
                        "description": "Invalid input, eg. non-integer ID",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Series not found, eg. ID that doesn't exist in the database",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error, unspecified internal errors",
                        "schema": {
                            "$ref": "#/definitions/models.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "description": "Machine-friendly error message for handling in front-end",
                    "type": "string",
                    "example": "lowercase_and_underscores"
                },
                "message": {
                    "description": "Human-friendly error message for the user",
                    "type": "string",
                    "example": "Capitalization and spaces"
                }
            }
        },
        "models.Serie": {
            "type": "object",
            "properties": {
                "id": {
                    "description": "Unique identifier for the series",
                    "type": "integer",
                    "example": 10
                },
                "lastEpisodeWatched": {
                    "description": "Last episode watched of the series",
                    "type": "integer",
                    "example": 15
                },
                "ranking": {
                    "description": "Score of the series used for ranking",
                    "type": "integer",
                    "example": 10
                },
                "status": {
                    "description": "Current status of the series; \"Watching\", \"Plan to Watch\", \"Dropped\", \"Completed\"",
                    "type": "string",
                    "example": "Watching"
                },
                "title": {
                    "description": "Title of the series",
                    "type": "string",
                    "example": "Breaking Bad"
                },
                "totalEpisodes": {
                    "description": "Quantity of episodes in the series",
                    "type": "integer",
                    "example": 24
                }
            }
        }
    }
}